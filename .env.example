# Required for AI analysis. For local development, copy this file to .env and
# paste your key after OPENAI_API_KEY=. Never commit the private .env file.
# On Render, set both values in Dashboard > Environment instead of uploading .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional local fallback: absolute path to the MuseScore Studio executable.
# Render uses the committed, hash-matched MusicXML exports and does not need this.
# MUSESCORE_PATH=C:\Program Files\MuseScore 4\bin\MuseScore4.exe

# Optional server settings.
# PORT=8787
# SCORES_DIR=C:\path\to\your\scores
# SCORE_CACHE_DIR=C:\path\to\a\cache

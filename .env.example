# Required for AI analysis. Copy this file to .env, then paste your key after
# OPENAI_API_KEY=. Never add the private .env file to source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional: absolute path to the MuseScore Studio executable.
# MUSESCORE_PATH=C:\Program Files\MuseScore 4\bin\MuseScore4.exe

# Optional server settings.
# PORT=8787
# SCORES_DIR=C:\path\to\your\scores
# SCORE_CACHE_DIR=C:\path\to\a\cache

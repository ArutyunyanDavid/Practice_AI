        "followOriginalKeySignature": true,
        "keepFullOctaves": true,
        "scaleDegreePatterns": [
          [1, 2, 1, 2],
          [1, 2, 3, 2, 1],
          [1, 2, 3, 4, 3, 2, 1],
          [1, 2, 3, 4, 5, 4, 3, 2, 1]
        ],
        "directionAboveExercise": "Play each pattern as fast and correctly as possible to build endurance."
      }
    },
    {

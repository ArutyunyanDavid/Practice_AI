  "methods": [
    {
      "id": "octave-separate-finger-lines",
      "exerciseNumber": 1,
      "title": "Separate Finger Lines",
      "instructions": [
        "This exercise improves separate control of the thumb and outer fingers when moving between octaves.",
        "Practice outer notes with finger 5 on white keys and 4 on black keys, then the thumb line."
      ],
      "applicability": {
        "patterns": ["runs", "jumps", "repeated", "long-mixed"],
        "minimumAttacks": 2,
        "maximumAttacks": null
      },
      "hands": {
        "oneHand": "write-only-the-affected-hand",
        "bothHands": "write-both-affected-hands-together-with-aligned-timing"
      },
      "notation": {
        "measureCount": 2,
        "passes": ["outer-finger-line", "finger-one-line"],
        "noteType": "eighth",
        "preserveOriginalRhythm": false,
        "preserveSourcePitchOrder": true,
        "firstMeasure": "outer pitches only with finger 5 on white keys or finger 4 on black keys",
        "secondMeasure": "thumb pitches only with finger 1"
      }
    },
    {
      "id": "octave-dotted-rhythm-variations",
      "exerciseNumber": 2,
      "title": "Dotted-Rhythm Variations",
      "instructions": [
        "This exercise develops even octave timing by alternating long and short notes.",
        "Play dotted eighths followed by sixteenths, then reverse the rhythm while keeping each beat steady."
      ],
      "applicability": {
        "patterns": ["runs", "jumps", "repeated", "long-mixed"],
        "minimumAttacks": 2,
        "maximumAttacks": null
      },
      "hands": {
        "oneHand": "write-only-the-affected-hand",
        "bothHands": "write-both-affected-hands-together-with-aligned-timing"
      },
      "notation": {
        "measureCount": 2,
        "passes": ["dotted-eighth-sixteenth", "sixteenth-dotted-eighth"],
        "preserveOriginalRhythm": false,
        "preserveSourcePitchOrder": true,
        "keepFullOctaves": true,
        "firstMeasureDurations": ["dotted-eighth", "sixteenth"],
        "secondMeasureDurations": ["sixteenth", "dotted-eighth"]
      }
    },
    {
      "id": "octave-expanding-five-note-pattern",
      "exerciseNumber": 3,
      "title": "Expanding Five-Note Pattern",
      "instructions": [
        "This exercise develops coordination and endurance as the octave pattern gradually grows.",
        "Build from two to five notes, increasing speed only while your hand stays relaxed and the notes remain accurate."
      ],
      "applicability": {
        "patterns": ["runs", "jumps", "repeated", "long-mixed"],
        "minimumAttacks": 2,
        "maximumAttacks": null
      },
      "hands": {
        "oneHand": "write-only-the-affected-hand",
        "bothHands": "generate-a-separate-sequence-for-each-affected-hand"
      },
      "notation": {
        "passes": ["two-note", "three-note", "four-note", "five-note"],
        "noteType": "eighth",
        "preserveOriginalRhythm": false,
        "startingPitch": "lowest-source-octave-position",
        "followOriginalKeySignature": true,
        "keepFullOctaves": true,
        "scaleDegreePatterns": [
          [1, 2, 1, 2],
          [1, 2, 3, 2, 1],
          [1, 2, 3, 4, 3, 2, 1],
          [1, 2, 3, 4, 5, 4, 3, 2, 1]
        ],
        "directionAboveExercise": "Play each pattern as fast and correctly as possible to build endurance."
      }
    },
    {
      "id": "octave-five-note-alternating-accents",
      "exerciseNumber": 4,
      "title": "Alternating Accent Octaves",
      "instructions": [
        "This exercise develops control of octave accents within a steady five-note pattern.",
        "Keep the five-note pattern even, accenting the lowest and highest notes on beats one and three."
      ],
      "applicability": {
        "patterns": ["runs"],
        "minimumAttacks": 2,
        "maximumAttacks": null,
        "excludePatterns": ["jumps"]
      },
      "hands": {
        "oneHand": "write-only-the-affected-hand",
        "bothHands": "generate-a-separate-sequence-for-each-affected-hand"
      },
      "notation": {
        "measureCount": 2,
        "passes": ["five-note-ascending-descending-twice"],
        "noteType": "eighth",
        "preserveOriginalRhythm": false,
        "startingPitch": "lowest-source-octave-position",
        "followOriginalKeySignature": true,
        "expandToFiveNotesWhenSourceIsShorter": true,
        "keepFullOctaves": true,
        "scaleDegreePatternPerMeasure": [1, 2, 3, 4, 5, 4, 3, 2],
        "accentEventIndexesPerMeasure": [0, 4],
        "accentBeatsPerMeasure": [1, 3],
        "directionAboveExercise": "Play each pattern as fast and correctly as possible to build endurance."
      }
    },
    {
      "id": "octave-progressive-groups-with-rests",
      "exerciseNumber": 5,
      "title": "Progressive Octave Groups",
      "instructions": [
        "This exercise develops accurate octave landings and relaxed recovery between groups.",
        "Add one octave at a time, rest after each group, and continue the pattern after the printed continuation mark."
      ],
      "applicability": {
        "patterns": ["runs", "jumps", "long-mixed"],
        "minimumAttacks": 4,
        "maximumAttacks": null,
        "requireConsecutiveAttacks": true,
        "allowStepwiseMotion": true,
        "allowJumps": true
      },
      "hands": {
        "oneHand": "write-only-the-affected-hand",
        "bothHands": "write-both-affected-hands-with-aligned-timing"
      },
      "notation": {
        "passes": ["progressively-longer-source-prefixes"],
        "noteType": "eighth",
        "preserveOriginalRhythm": false,
        "preserveSourcePitchOrder": true,
        "keepFullOctaves": true,
        "groupCountFormula": "min(3, totalOctaveAttacks - 1)",
        "maximumGeneratedGroups": 3,
        "addOneOctavePerGroup": true,
        "restAfterEveryGroup": true,
        "doNotWriteEntireExercise": true,
        "directionAfterFinalGroup": "Etc."
      }
    },
    {
      "id": "octave-repeated-pairs-alternating-accents",
      "exerciseNumber": 6,
      "title": "Repeated Octave Accent Pairs",
      "instructions": [
        "This exercise develops control over which octave receives emphasis in each repeated pair.",
        "Repeat each octave twice, accenting the first attack in measure one and the second attack in measure two."
      ],
      "applicability": {
        "patterns": ["runs", "jumps", "long-mixed"],
        "minimumAttacks": 2,
        "maximumAttacks": null
      },
      "hands": {
        "oneHand": "write-only-the-affected-hand",
        "bothHands": "generate-a-separate-sequence-for-each-affected-hand"
      },
      "notation": {
        "measureCount": 2,
        "passes": ["accent-first-of-pair", "accent-second-of-pair"],
        "noteType": "eighth",
        "preserveOriginalRhythm": false,
        "preserveSourcePitchOrder": true,
        "keepFullOctaves": true,
        "positionCount": 4,
        "repeatEachPosition": 2,
        "cyclePositionsWhenSourceIsShorter": true,
        "truncatePositionsWhenSourceIsLonger": true,
        "firstMeasureAccentEventIndexes": [0, 2, 4, 6],
        "secondMeasureAccentEventIndexes": [1, 3, 5, 7]
      }
